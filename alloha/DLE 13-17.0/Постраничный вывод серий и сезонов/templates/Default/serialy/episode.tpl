[metatags]
<title>{title} {season} сезон {episode} серия смотреть онлайн</title>
<description>Описание страницы</description>
[/metatags]



<article class="box story[fixed] fixed_story[/fixed] fullstory" itemscope itemtype="http://schema.org/Article">
	<div class="box_in">
		<h2 class="title" itemprop="headline">{title} {season} сезон {episode} серия смотреть онлайн</h2>
		
		[episode-title] <h2>{episode-title}</h2> [/episode-title]
		<img src="{kadr}" alt="" width="500">
        <iframe width="560" height="400" src="[xfvalue_iframe_url]?season={season}&episode={episode}" frameborder="0" allowfullscreen></iframe>

[prev-episode]{prev-episode} серия[/prev-episode]
    [next-episode]{next-episode} серия[/next-episode]
		{story}
	</div>	
</article>	
